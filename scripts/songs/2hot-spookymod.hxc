import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import flixel.util.FlxSave;

class TwoHOTSpookymodMixSong extends Song {
	function new() {
		super('2hot', {
			variation: 'spookymod'
		});
		save = new FlxSave();
		save.bind("SpookyUpdatedCheck", "FunkinCrew");
	}

	public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool {
		if (save.data.beatenTwoHotUpdated == null) {
			save.data.beatenTwoHotUpdated = false;
			save.flush();	
		}
		return !save.data.beatenTwoHotUpdated;
	}

	public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String> {
		var targetDifficulty:Null<SongDifficulty> = getDifficulty(difficultyId, variationId);
		
		if (save.data.beatenTwoHotUpdated == true)
			return targetDifficulty?.characters?.altInstrumentals ?? [];
		else
			return [];
	}

	public override function onSongEnd(event:CountdownScriptEvent):Void {
		super.onSongEnd(event);
		if (PlayState.instance == null || PlayState.instance.isChartingMode || PlayState.instance.isMinimalMode) return;
		save.data.beatenTwoHotUpdated = true;
		save.flush();
	}
}
