import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import funkin.play.PlayStatePlaylist;
import funkin.modding.base.ScriptedFlxSpriteGroup;
import Date;
import flixel.FlxG;

class stressSpookymodMixSong extends Song {
	function new() {
		super('stress', {
			variation: 'spookymod'
		});
	}

	var hasPlayedCutscene:Bool;
	var tankmanGroup:SpookyTankmanSpriteGroup = null;

	override function onSongLoaded(event) {
		super.onSongLoaded(event);
		if (PlayState.instance.currentInstrumental != "spookymod" && PlayState.instance.currentInstrumental != "truespookymod") {
			PlayState.instance.currentVariation = "spookymodalt";
			PlayState.currentChart = PlayState.instance.currentSong.getDifficulty(PlayState.instance.currentDifficulty + "-spookymodalt", "spookymodalt");
			PlayState.instance.vocals = PlayState.instance.currentChart.buildVocals("spookymodalt");
			event.notes = PlayState.instance.currentChart.notes.copy();
			event.events = PlayState.instance.currentChart.getEvents();
		}
		if (PlayState.instance.currentInstrumental == "spookymod" || PlayState.instance.currentInstrumental == "truespookymod") {
			PlayState.instance.currentInstrumental = "truespookymod";
		}
	}

	function onCreate(event:ScriptEvent):Void {
		super.onCreate(event);
		if (!FlxG.onMobile) {
			PlayState.instance.discordRPCAlbum = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/album-covers/"
				+ PlayState.instance.currentChart.album
				+ ".png?raw=true";
			PlayState.instance.discordRPCIcon = "https://raw.githubusercontent.com/LeGooeyy/GooeyMixDiscordIcons/refs/heads/main/assets/icons/"
				+ PlayState.instance.currentChart.characters.opponent
				+ ".png?raw=true?t="
				+ Date.now().getTime();
		}
	}

	public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String> {
		var targetDifficulty:Null<SongDifficulty> = getDifficulty(difficultyId, variationId);

		if (Save.instance.hasBeatenSong(this.id, null, variationId))
			return targetDifficulty?.characters?.altInstrumentals ?? [];
		else
			return [];
	}

	public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool {
		return !Save.instance.hasBeatenSong(this.id, null, 'spookymod');
	}

	public override function onCountdownStart(event:CountdownScriptEvent):Void {
		super.onCountdownStart(event);


		if (tankmanGroup != null && !tankmanGroup.scriptCall('isValid')) {
			// Destroy the tankman group if it's not valid.
			tankmanGroup.destroy();
			PlayState.instance.currentStage.remove(tankmanGroup);
			tankmanGroup = null;
		}

		if (tankmanGroup == null) {
			// Initialize the tankman group if it's not available.
			trace('Initializing tankman group... ' + PlayState.instance.currentVariation);
			tankmanGroup = ScriptedFlxSpriteGroup.init('SpookyTankmanSpriteGroup', PlayState.instance.currentVariation != 'default');
		}

		if (tankmanGroup != null) {
			// resets the tankmen!
			tankmanGroup.scriptCall('reset');

			tankmanGroup.zIndex = 30;
			PlayState.instance.currentStage.add(tankmanGroup);
			PlayState.instance.currentStage.refresh();
		} else {
			trace('Failed to initialize tankman group!');
		}
	}

	function onSongRetry(event:ScriptEvent) {
		super.onSongRetry(event);

		hasPlayedCutscene = true;

		// resets the tankmen!
		if (tankmanGroup != null) {
			tankmanGroup.scriptCall('reset');
		}
		if (PlayState.instance.currentStage.getGirlfriend() != null) {
			PlayState.instance.currentStage.getGirlfriend().scriptCall('reset');
			trace('reset moloch!');
		}
	}

	function kill():Void {
		cleanupTankmanGroup();
	}

	function cleanupTankmanGroup():Void {
		if (tankmanGroup != null) {
			PlayState.instance.currentStage.remove(tankmanGroup);
			tankmanGroup.destroy();
			tankmanGroup = null;
		}
	}
}
