import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;

class UghSpookymodMixSong extends Song {
	function new() {
		super('ugh', {
			variation: 'spookymod'
		});
	}

	override function onSongLoaded(event) {
		super.onSongLoaded(event);
		if (PlayState.instance.currentInstrumental != "spookymod" && PlayState.instance.currentInstrumental != "truespookymod") {
			PlayState.instance.currentVariation = "spookymodalt";
			PlayState.currentChart = PlayState.instance.currentSong.getDifficulty(PlayState.instance.currentDifficulty + "-spookymodalt", "spookymodalt");
			PlayState.instance.vocals = PlayState.instance.currentChart.buildVocals("spookymodalt");
			event.notes = PlayState.instance.currentChart.notes.copy();
			event.events = PlayState.instance.currentChart.getEvents();
		}
		if (PlayState.instance.currentInstrumental == "spookymod" || PlayState.instance.currentInstrumental == "truespookymod") {
			PlayState.instance.currentInstrumental = "truespookymod";
		}
	}

	public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String> {
		var targetDifficulty:Null<SongDifficulty> = getDifficulty(difficultyId, variationId);

		if (Save.instance.hasBeatenSong(this.id, null, variationId))
			return targetDifficulty?.characters?.altInstrumentals ?? [];
		else
			return [];
	}
}
