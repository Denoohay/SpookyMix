import funkin.play.song.Song;
import funkin.save.Save;
import funkin.play.PlayState;
import flixel.FlxG;

class BlazinSpookymodMixSong extends Song {
	function new() {
		super('blazin', {
			variation: 'spookymod'
		});
	}

	public override function isSongNew(currentDifficulty:String, currentVariation:String):Bool {
		return !Save.instance.hasBeatenSong(this.id, null, 'spookymod');
	}

	public override function listAltInstrumentalIds(difficultyId:String, variationId:String):Array<String> {
		var targetDifficulty:Null<SongDifficulty> = getDifficulty(difficultyId, variationId);

		if (Save.instance.hasBeatenSong(this.id, null, variationId))
			return targetDifficulty?.characters?.altInstrumentals ?? [];
		else
			return [];
	}
}