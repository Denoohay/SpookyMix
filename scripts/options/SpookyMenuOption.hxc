import funkin.PlayerSettings;
import funkin.modding.module.Module;
import funkin.util.ReflectUtil;
import flixel.FlxG;
import funkin.ui.options.OptionsState;
import funkin.audio.FunkinSound;
import funkin.ui.FullScreenScaleMode;
import flixel.FlxSprite;
import funkin.Assets;
import openfl.media.Sound;

class SpookyMenuOption extends Module {
	var addedTitle:Bool = false;
	var changedIntroText:Bool = false;

	var skidDance:FlxSprite;
	var pumpDance:FlxSprite;
	var logoSpooky:FlxSprite;
	var titleText:FlxSprite;

	final TITLE_TEXT_OFFSET(get, never):Int;

	function get_TITLE_TEXT_OFFSET():Int {
		return FlxG.onMobile ? 100 : 150;
	}

	var menuTheme(default, set):String = "freakyMenu";
	var oldTheme:String;

	function set_menuTheme(value:String) {
		var baseAssetPath:String = Paths.music("freakyMenu/freakyMenu");
		var newAssetPath:String = Assets.getPath(Paths.music(value + "/" + value));

		if (FlxG.onMobile) {
			var newAssetPath:String = Paths.music(value + "/" + value);
			Assets.cache.setSound(baseAssetPath, Assets.getSound(newAssetPath));
			Assets.cache.removeSound(newAssetPath);
		} else {
			Assets.cache.setSound(baseAssetPath, Sound.fromFile(newAssetPath));
		}
	}

	public function new() {
		super('SpookyMenuOption');

		menuTheme = getMusicId();
		oldTheme = getMusicId();
	}

	override function onUpdate(event:UpdateScriptEvent) {
		super.onUpdate(event);

		if (FlxG.save.data.SpookyMixMenu != 'Always On'
			&& FlxG.save.data.SpookyMixMenu != 'Spooky Kids Selected'
			&& FlxG.save.data.SpookyMixMenu != 'Off')
			FlxG.save.data.SpookyMixMenu = 'Always On';

		// TITLE SCREEN
		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.title.TitleState") {
			FlxG.mouse.visible = false;

			if (FlxG.save.data.SpookyMixMenu == 'Always On'
				|| (FlxG.save.data.SpookyMixMenu == 'Spooky Kids Selected' && FlxG.save.data.rememberedStartupCharacter == "spookymod")) {
				if (!changedIntroText) {
					changedIntroText = true;
					var fullText:String = Assets.getText(Paths.txt('introTextSpooky'));
					var firstArray:Array<String> = fullText.split('\n').filter(function(s:String) return s != '');
					var swagGoodArray:Array<Array<String>> = [];
					for (i in firstArray) {
						swagGoodArray.push(i.split('--'));
					}
					FlxG.state.curWacky = swagGoodArray[FlxG.random.int(0, swagGoodArray.length - 1)];
				}
				if (FlxG.state.logoBl != null && FlxG.state.gfDance != null && FlxG.state.titleText != null && FlxG.state.skippedIntro && !addedTitle) {
					addedTitle = true;

					addTitleScreenObjects();
				}
			}
		}

		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.mainmenu.StoryMenuState") {
			if (oldTheme != getMusicId()) {
				menuTheme = getMusicId();
				oldTheme = getMusicId();
			}
		}

		// MENU BACKGROUND
		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.mainmenu.MainMenuState") {
			if (oldTheme != getMusicId()) {
				menuTheme = getMusicId();
				oldTheme = getMusicId();
			}

			if (FlxG.state.magenta != null) {
				if (FlxG.save.data.SpookyMixMenu == 'Always On'
					|| (FlxG.save.data.SpookyMixMenu == 'Spooky Kids Selected'
						&& FlxG.save.data.rememberedStartupCharacter == "spookymod")) {
					if (FlxG.state.magenta.graphic.key == 'assets/images/menuBGMagenta.png') {
						FlxG.state.magenta.loadGraphic(Paths.image('SpookyMenuBGMagenta'));
						FlxG.state.members[0].loadGraphic(Paths.image('SpookyMenuBG'));
					}
				} else {
					if (FlxG.state.magenta.graphic.key == 'assets/images/SpookyMenuBGMagenta.png') {
						FlxG.state.magenta.loadGraphic(Paths.image('menuBGMagenta'));
						FlxG.state.members[0].loadGraphic(Paths.image('menuBG'));
					}
				}
			}
		}

		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.options.OptionsState") { 
			if (FlxG.state.members[0] != null) {
				if (FlxG.save.data.SpookyMixMenu == 'Always On'
					|| (FlxG.save.data.SpookyMixMenu == 'Spooky Kids Selected'
						&& FlxG.save.data.rememberedStartupCharacter == "spookymod")) {
					if (FlxG.state?.members[0]?.graphic.key == 'assets/images/menuBG.png') {
						FlxG.state.members[0].loadGraphic(Paths.image('SpookyMenuBG'));
					}
				} else {
					if (FlxG.state?.members[0]?.graphic.key == 'assets/images/SpookyMenuBG.png') {
						FlxG.state.members[0].loadGraphic(Paths.image('menuBG'));
					}
				}
			}

			if (oldTheme != getMusicId()) {
				FlxG.sound.music.stop();
				menuTheme = getMusicId();
				FunkinSound.playMusic('freakyMenu', {
					startingVolume: 1.0,
					overrideExisting: true,
					restartTrack: false,
					// Continue playing this music between states, until a different music track gets played.
					persist: true
				});
			}
			oldTheme = getMusicId();
		}

		if (ReflectUtil.getClassNameOf(FlxG.state.subState) == "funkin.ui.debug.DebugMenuSubState") {
			if (FlxG.state.subState.members[3] != null) {
				if (FlxG.save.data.SpookyMixMenu == 'Always On'
					|| (FlxG.save.data.SpookyMixMenu == 'Spooky Kids Selected'
						&& FlxG.save.data.rememberedStartupCharacter == "spookymod")) {
					if (FlxG.state.subState.members[3].graphic.assetPath == 'assets/images/menuDesat.png') {
						FlxG.state.subState.members[3].loadGraphic(Paths.image('SpookyMenuDesat'));
					}
				} else {
					if (FlxG.state.subState.members[3].graphic.assetPath == 'assets/images/SpookyMenuDesat.png') {
						FlxG.state.subState.members[3].loadGraphic(Paths.image('menuDesat'));
					}
				}
			}
		}

		if (ReflectUtil.getClassNameOf(FlxG.state) == "funkin.ui.debug.charting.ChartEditorState") {
			if (FlxG.state.menuBG != null) {
				if (FlxG.state.selectedVariation == 'spookymod') {
					if (FlxG.state.menuBG.graphic.assetPath == 'assets/images/menuDesat.png') {
						FlxG.state.menuBG.loadGraphic(Paths.image('SpookyMenuDesat'));
					}
				} else {
					if (FlxG.state.menuBG.graphic.assetPath == 'assets/images/SpookyMenuDesat.png') {
						FlxG.state.menuBG.loadGraphic(Paths.image('menuDesat'));
					}
				}
			}
		}
	}

	public function onStateChangeEnd(event:StateChangeScriptEvent) {
		addedTitle = false;

		if (Std.isOfType(event.targetState, OptionsState)) {
			if (event.targetState.optionsCodex.pages.get("preferences") != null) {
				event.targetState.optionsCodex.pages.get("preferences")
					.createPrefItemEnum('Spooky Menu', "Switch between using Spooky Mix's or FNF's menu themes.", [
						'Always On' => 'Always On',
						'Off' => 'Off',
						'Spooky Kids Selected' => 'Spooky Kids Selected'
					], function(value:String, oValue:String):Void {
						FlxG.save.data.SpookyMixMenu = value;
						FlxG.save.data.flush;

						if (oldTheme != getMusicId()) {
							FlxG.sound.music.stop();
							menuTheme = getMusicId();
							FunkinSound.playMusic('freakyMenu', {
								startingVolume: 1.0,
								overrideExisting: true,
								restartTrack: false,
								// Continue playing this music between states, until a different music track gets played.
								persist: true
							});
						}
						oldTheme = getMusicId();
					}, FlxG.save.data.SpookyMixMenu);
			}
		}
	}

	public function getMusicId():String {
		if (FlxG.save.data.SpookyMixMenu == 'Always On'
			|| (FlxG.save.data.SpookyMixMenu == 'Spooky Kids Selected' && FlxG.save.data.rememberedStartupCharacter == "spookymod")
			|| FlxG.save.data.SpookyMixMenu == null)
			return "gettinSpooky";
		else
			return "freakyMenu";
	}

	function addTitleScreenObjects():Void {
		if (oldTheme != getMusicId()) {
			menuTheme = getMusicId();
			oldTheme = getMusicId();
		}

		FlxG.state.logoBl.frames = Paths.getSparrowAtlas('spookyLogo');
		FlxG.state.logoBl.y = 9;
		FlxG.state.logoBl.screenCenter(0x01);
		FlxG.state.logoBl.animation.addByPrefix('bump', 'logo', 24);

		skidDance = new FlxSprite(FlxG.state.logoBl.x - 275, 283);
		skidDance.frames = Paths.getSparrowAtlas('skidDanceTitle');
		skidDance.animation.addByPrefix('dance', 'skidDance instance 1', 24, true);
		skidDance.animation.play('dance');
		skidDance.shader = FlxG.state.swagShader.shader;
		skidDance.visible = false;
		FlxG.state.add(skidDance);

		pumpDance = new FlxSprite(FlxG.state.logoBl.x + 565, 277);
		pumpDance.frames = Paths.getSparrowAtlas('pumpDanceTitle');
		pumpDance.animation.addByPrefix('dance', 'pumpDance instance 1', 24, true);
		pumpDance.animation.play('dance');
		pumpDance.shader = FlxG.state.swagShader.shader;
		pumpDance.visible = false;
		FlxG.state.add(pumpDance);

		if (FlxG.onMobile) {
			FlxG.state.titleText.frames = Paths.getSparrowAtlas('titleEnterSpooky_mobile');
		} else {
			FlxG.state.titleText.frames = Paths.getSparrowAtlas('titleEnterSpooky');
		}

		FlxG.state.titleText.x = TITLE_TEXT_OFFSET + (FullScreenScaleMode.gameCutoutSize.x / 2);
		FlxG.state.titleText.animation.addByPrefix('idle', "Press Enter to Begin", 24);
		FlxG.state.titleText.animation.addByPrefix('press', "ENTER PRESSED", 24);
		FlxG.state.titleText.animation.play('idle');
		FlxG.state.titleText.y = 605;

		skidDance.visible = true;
		pumpDance.visible = true;

		FlxG.state.gfDance.visible = false;
	}
}
