import funkin.ui.charSelect.CharSelectSubState;
import funkin.modding.module.Module;
import funkin.save.Save;

class SpookyCharSelectScreen extends Module {
	public function new() {
		super('SpookyCharSelectScreen', 1, {
			state: CharSelectSubState
		});
	}

	override function onCharacterSelected(event:UpdateScriptEvent) {
		super.onCharacterSelected(event);

		if (FlxG.state.curChar != "locked")
			Save.instance.addCharacterSeen(FlxG.state.curChar);
		if (FlxG.state.gfChill != null) {
			if (FlxG.state.curChar == 'spookymod') {
				FlxG.state.gfChill.danceEvery = 1;
			} else {
				FlxG.state.gfChill.danceEvery = 2;
			}
		}
	}
}
