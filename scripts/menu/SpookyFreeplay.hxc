import funkin.ui.freeplay.FreeplayState;
import funkin.modding.module.Module;
import funkin.Conductor;
import funkin.Preferences;
import flixel.FlxG;
import StringTools;
import funkin.audio.FunkinSound;
import flixel.util.FlxTimer;
import funkin.ui.freeplay.CapsuleNumber;
import funkin.ui.freeplay.SongMenuItem;

class SpookyFreeplay extends Module {
	public function new() {
		super('SpookyFreeplay');
	}

	var updatedSongsList:Array<SongMenuItem>;

	override function onSubStateOpenBegin(event) {
        super.onSubStateOpenBegin(event);
		if (event.targetState is FreeplayState) {
			canPlayTutorialPreview = false;
			if ((updatedSongsList?.length ?? 1) > 0) updatedSongsList = [];	
		}
	}

	public function onDifficultySwitch(event:CapsuleScriptEvent):Void {
		super.onDifficultySwitch(event);
		
		if (FlxG.state.subState.currentCharacterId == 'spookymod') {
			while (updatedSongsList?.length > 0) {
				var capsule = updatedSongsList.shift();

				if (StringTools.contains(capsule?.newText?.graphic?.key, 'freeplay/freeplayCapsule/updated')) {
					capsule.newText.frames = Paths.getSparrowAtlas('freeplay/freeplayCapsule/new');
					capsule.newText.animation.addByPrefix('newAnim', 'NEW notif', 24, true);
					capsule.newText.animation.play('newAnim', true);
					capsule.newText.offset.x = 0;	
				}
			}
			var updatedSongs:Array<SongMenuItem> = FlxG.state.subState.grpCapsules.members.filter(function(cap:SongMenuItem) {
				var updated = ["high", "milf", "darnell", "lit-up", "2hot"];
				return cap != null && cap.alive && cap.freeplayData?.data != null && updated.contains(cap.freeplayData?.data.id);
			});
			for (capsule in updatedSongs) {
				if (capsule == null || !capsule.alive) continue;

				updatedSongsList.push(capsule);

				capsule.newText.frames = Paths.getSparrowAtlas('freeplay/freeplayCapsule/updated');
				capsule.newText.animation.addByPrefix('updatedAnim', 'UPDATED notif', 24, true);
				capsule.newText.animation.play('updatedAnim', true);
				capsule.newText.offset.x = 70;
			}
		}
	}

	override function onUpdate(event:UpdateScriptEvent) {
		super.onUpdate(event);
		if (FlxG.state?.subState == null || !(FlxG.state.subState is FreeplayState)) return;

		if (FlxG.state.subState?.instSelectMenu != null) {
			if (StringTools.startsWith(FlxG.state.subState.instSelectMenu.currentInstrumental.text, "Truespookymod")
				|| StringTools.startsWith(FlxG.state.subState.instSelectMenu.currentInstrumental.text, "Spookymod"))
				FlxG.state.subState.instSelectMenu.currentInstrumental.text = "Spooky";
		}
	}
}
