import funkin.play.character.AnimateAtlasCharacter;
import funkin.play.character.CharacterType;

class DadSpookyCharacter extends AnimateAtlasCharacter {
	function new() {
		super('dad-spooky');
	}

	function onNoteHit(event:HitNoteScriptEvent) {
		if (!event.note.noteData.getMustHitNote() && characterType == CharacterType.DAD) {
			switch (event.note.kind) {
				case "Scare":
					holdTimer = 0;
					this.playAnimation('scare', false);
				case "scare":
					holdTimer = 0;
					this.playAnimation('scare', false);
				default:
					holdTimer = 0;
					this.playSingAnimation(event.note.noteData.getDirection(), false);
			}
		}
	}
}
