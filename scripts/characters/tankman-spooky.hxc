import funkin.play.character.MultiAnimateAtlasCharacter;
import funkin.play.character.CharacterType;
import funkin.play.PlayState;

class TankmanSpookyCharacter extends MultiAnimateAtlasCharacter {
	function new() {
		super('tankman-spooky');
	}

	var isMonster:Bool = false;

	override function playAnimation(name:String, restart:Bool = false, ignoreOther:Bool = false, reversed:Bool = false) {
		if (isMonster) {
			this.danceEvery = 2;
			this.scale.set(0.8, 0.8);
			super.playAnimation(name + '-monster', restart, ignoreOther, reversed);
		} else {
			this.danceEvery = 4;
			super.playAnimation(name, restart, ignoreOther, reversed);
		}

		if (name == 'weirdAppears')
			isMonster = true;
	}

	override function onSongRetry(event:ScriptEvent):Void {
		super.onSongRetry(event);
		isMonster = false;
	}

	function onNoteHit(event:HitNoteScriptEvent) {
		super.onNoteHit(event);
		if (!event.note.noteData.getMustHitNote() && characterType == CharacterType.DAD) {
			switch (event.note.kind) {
				case "ugh":
					holdTimer = 0;
					this.playAnimation('ugh', true, true);
					return;
				case "hehPrettyGood":
					holdTimer = 0;
					this.playAnimation('hehPrettyGood', true, true);
					return;
			}
		}
	}
}
